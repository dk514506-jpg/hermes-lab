[
  { "id": "capture_observation",
    "template": "capture_observation | source={evidence_sources} | content={observation_text} | timestamp={ts}",
    "description": "Record a raw observation with provenance; observation layer only, no interpretation.",
    "arguments": { "source": "{evidence_sources}", "content": "{observation_text}", "timestamp": "{ts}" } },
  { "id": "classify_observation_type",
    "template": "classify_observation_type | observation={observation_id}",
    "description": "Tag observation as behavior / statement / artifact / pattern.",
    "arguments": { "observation": "{observation_id}" } },
  { "id": "separate_inference_layers",
    "template": "separate_inference_layers | claim={claim_text}",
    "description": "Enforce observation | interpretation | implication | action layer separation on any emerging claim.",
    "arguments": { "claim": "{claim_text}" } },
  { "id": "form_interpretation_hypothesis",
    "template": "form_interpretation_hypothesis | observations={observation_ids} | hypothesis={hypothesis_text}",
    "description": "Generate a candidate interpretation explicitly marked as hypothesis, citing supporting observations.",
    "arguments": { "observations": "{observation_ids}", "hypothesis": "{hypothesis_text}" } },
  { "id": "link_evidence_edges",
    "template": "link_evidence_edges | insight={insight_id} | observations={observation_ids} | strength={strength}",
    "description": "Create observation-to-insight evidence edges with strength and provenance.",
    "arguments": { "insight": "{insight_id}", "observations": "{observation_ids}", "strength": "{strength}" } },
  { "id": "score_evidence_sufficiency",
    "template": "score_evidence_sufficiency | insight={insight_id} | count={observation_count} | diversity={source_diversity}",
    "description": "Rate supporting evidence as insufficient / partial / sufficient per insight.",
    "arguments": { "insight": "{insight_id}", "count": "{observation_count}", "diversity": "{source_diversity}" } },
  { "id": "detect_schematic_convergence",
    "template": "detect_schematic_convergence | insights={insight_ids}",
    "description": "Assess whether independent observations converge on the same schematic (SERUM-style); distinguish emerging from schematic_equilibrium.",
    "arguments": { "insights": "{insight_ids}" } },
  { "id": "flag_identity_level_claim",
    "template": "flag_identity_level_claim | insight={insight_id}",
    "description": "Detect interpretations about who the user is (identity level); default to quarantine pending explicit confirmation.",
    "arguments": { "insight": "{insight_id}" } },
  { "id": "quarantine_insight",
    "template": "quarantine_insight | insight={insight_id} | reason={reason}",
    "description": "Move an insight into the quarantined set; quarantined insights may not steer any action.",
    "arguments": { "insight": "{insight_id}", "reason": "{reason}" } },
  { "id": "derive_implication_and_action",
    "template": "derive_implication_and_action | insight={insight_id}",
    "description": "Produce implication and proposed-action layers, each marked hypothesis-derived and non-binding.",
    "arguments": { "insight": "{insight_id}" } },
  { "id": "present_lattice_for_review",
    "template": "present_lattice_for_review | lattice={lattice_id} | mode={mode}",
    "description": "Render the lattice with separated layers and evidence citations for user review.",
    "arguments": { "lattice": "{lattice_id}", "mode": "{mode}" } },
  { "id": "record_user_verdict",
    "template": "record_user_verdict | insight={insight_id} | verdict={verdict} | correction={correction_text}",
    "description": "Record user accept / reject / revise / correct and propagate through dependent insights.",
    "arguments": { "insight": "{insight_id}", "verdict": "{verdict}", "correction": "{correction_text}" } }
]
